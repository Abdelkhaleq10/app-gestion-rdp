<html>
<head>
  <title>RDP DEMANDE ACCES</title>

  <HTA:APPLICATION
    ID="RDP_DEMANDE_ACCES"
    APPLICATIONNAME="RDP_DEMANDE_ACCES"
    BORDER="thin"
    CAPTION="yes"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="normal"
    SCROLL="no"
  />

  <meta http-equiv="x-ua-compatible" content="IE=9" />

  <style>
    html, body {
      margin: 0;
      padding: 0;
      width: 560px;
      height: 430px;
      overflow: hidden;
      font-family: "Segoe UI", Arial, sans-serif;
      background: #eef4fb;
      color: #0f172a;
    }

    .page {
      width: 530px;
      height: 395px;
      margin: 14px auto;
      background: #ffffff;
      border: 1px solid #d5e3f5;
      border-radius: 14px;
      box-shadow: 0 16px 36px rgba(15, 23, 42, 0.20);
      overflow: hidden;
    }

    .header {
      height: 82px;
      background: #0b2a5b;
      color: white;
      padding: 16px 20px;
      box-sizing: border-box;
    }

    .brand {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 2px;
      color: #bdd7ff;
      text-transform: uppercase;
      margin-bottom: 7px;
    }

    .title {
      font-size: 20px;
      font-weight: 800;
      line-height: 24px;
      color: #ffffff;
    }

    .content {
      padding: 16px 20px 14px 20px;
      box-sizing: border-box;
    }

    .info {
      background: #f8fbff;
      border: 1px solid #dce8f7;
      border-radius: 12px;
      padding: 12px 14px;
      margin-bottom: 14px;
    }

    .row {
      font-size: 14px;
      line-height: 24px;
      color: #334155;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .label {
      display: inline-block;
      width: 82px;
      font-weight: 800;
      color: #0f172a;
    }

    .value {
      color: #334155;
      font-weight: 600;
    }

    .question {
      text-align: center;
      font-size: 16px;
      font-weight: 800;
      color: #0b2a5b;
      margin: 12px 0 10px 0;
    }

    .notice {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      color: #1e40af;
      border-radius: 10px;
      padding: 9px 12px;
      font-size: 12px;
      line-height: 17px;
      text-align: center;
      font-weight: 600;
      margin-bottom: 14px;
    }

    .actions {
      height: 48px;
      text-align: center;
      margin-bottom: 8px;
    }

    .btn {
      width: 135px;
      height: 42px;
      border: 0;
      border-radius: 11px;
      color: white;
      font-size: 16px;
      font-weight: 900;
      margin: 0 12px;
      cursor: pointer;
      box-shadow: 0 8px 18px rgba(15, 23, 42, 0.18);
    }

    .yes {
      background: #16a34a;
    }

    .no {
      background: #dc2626;
    }

    .btn:hover {
      opacity: 0.92;
    }

    .btn:disabled {
      opacity: 0.55;
      cursor: default;
    }

    .sent {
      display: none;
      text-align: center;
      font-size: 12px;
      color: #16a34a;
      font-weight: 800;
      margin-top: 4px;
    }

    .timer {
      text-align: center;
      font-size: 12px;
      color: #64748b;
      font-weight: 700;
      margin-top: 4px;
    }
  </style>

  <script language="javascript">
    var fso = new ActiveXObject("Scripting.FileSystemObject");

    var responseDir = "C:\\Logs\\RDP_Request_Responses";
    var currentPopupFile = responseDir + "\\popup-current.json";

    var requestId = 0;
    var popupToken = "";
    var secondsLeft = 60;
    var answered = false;
    var timerInterval = null;
    var currentInterval = null;

    function readText(filePath) {
      var f = fso.OpenTextFile(filePath, 1, false);
      var t = f.ReadAll();
      f.Close();
      return t;
    }

    function writeText(filePath, text) {
      var f = fso.CreateTextFile(filePath, true);
      f.Write(text);
      f.Close();
    }

    function parseJson(text) {
      return eval("(" + text + ")");
    }

    function clean(value, fallback) {
      value = String(value || "");
      value = value.replace(/^\s+|\s+$/g, "");
      if (!value) return fallback || "-";
      return value;
    }

    function esc(value) {
      value = String(value || "");
      value = value.replace(/&/g, "&amp;");
      value = value.replace(/</g, "&lt;");
      value = value.replace(/>/g, "&gt;");
      value = value.replace(/"/g, "&quot;");
      return value;
    }

    function setHtml(id, value) {
      document.getElementById(id).innerHTML = esc(value);
    }

    function closeMe() {
      try {
        if (timerInterval) clearInterval(timerInterval);
        if (currentInterval) clearInterval(currentInterval);
      } catch (e) {}
      window.close();
    }

    function loadPopup() {
      try {
        if (!fso.FileExists(currentPopupFile)) {
          closeMe();
          return;
        }

        var data = parseJson(readText(currentPopupFile));

        requestId = parseInt(data.requestId, 10);
        popupToken = String(data.popupToken || "");

        setHtml("employee", clean(data.employee || data.Utilisateur || data.employee_name, "Utilisateur"));
        setHtml("reason", clean(data.reason || data.priority, "-"));
        setHtml("message", clean(data.message, "-"));

        window.resizeTo(575, 465);
        window.moveTo(
          Math.max(0, (screen.width - 575) / 2),
          Math.max(0, (screen.height - 465) / 2)
        );
        window.focus();
      } catch (e) {
        closeMe();
      }
    }

    function checkCurrentPopup() {
      try {
        if (!fso.FileExists(currentPopupFile)) {
          closeMe();
          return;
        }

        var data = parseJson(readText(currentPopupFile));

        if (parseInt(data.requestId, 10) !== requestId) {
          closeMe();
          return;
        }

        if (String(data.popupToken || "") !== popupToken) {
          closeMe();
          return;
        }
      } catch (e) {
        closeMe();
      }
    }

    function disableButtons() {
      document.getElementById("yesBtn").disabled = true;
      document.getElementById("noBtn").disabled = true;
    }

    function sendAnswer(answer) {
      if (answered) return;
      answered = true;

      try {
        disableButtons();
        document.getElementById("sent").style.display = "block";

        var responseFile = responseDir + "\\request_" + requestId + ".txt";
        writeText(responseFile, answer);
      } catch (e) {}

      window.setTimeout(function () {
        closeMe();
      }, 300);
    }

    function tick() {
      if (answered) return;

      checkCurrentPopup();

      secondsLeft = secondsLeft - 1;
      if (secondsLeft < 0) secondsLeft = 0;

      document.getElementById("timer").innerHTML =
        "Expiration automatique dans " + secondsLeft + " secondes";

      if (secondsLeft <= 0) {
        sendAnswer("TIMEOUT");
      }
    }

    window.onload = function () {
      loadPopup();
      currentInterval = setInterval(checkCurrentPopup, 500);
      timerInterval = setInterval(tick, 1000);
    };
  </script>
</head>

<body>
  <div class="page">
    <div class="header">
      <div class="brand">SRM-SM | Acces au poste principal</div>
      <div class="title">Nouvelle demande d'acces RDP</div>
    </div>

    <div class="content">
      <div class="info">
        <div class="row"><span class="label">Employe :</span><span class="value" id="employee">...</span></div>
        <div class="row"><span class="label">Motif :</span><span class="value" id="reason">...</span></div>
        <div class="row"><span class="label">Message :</span><span class="value" id="message">...</span></div>
      </div>

      <div class="question">Voulez-vous liberer la session actuelle ?</div>

      <div class="notice">
        Si une demande plus prioritaire arrive, cette fenetre sera remplacee automatiquement.
      </div>

      <div class="actions">
        <button id="yesBtn" class="btn yes" onclick="sendAnswer('YES')">Oui</button>
        <button id="noBtn" class="btn no" onclick="sendAnswer('NO')">Non</button>
      </div>

      <div id="sent" class="sent">Reponse envoyee...</div>
      <div id="timer" class="timer">Expiration automatique dans 60 secondes</div>
    </div>
  </div>
</body>
</html>